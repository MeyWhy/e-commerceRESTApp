# Copy this file to .env and adjust values for your local setup.
# .env is git-ignored — never commit real credentials.

# --- Order DB ---
ORDER_DB_ROOT_PASSWORD=rootpassword
ORDER_DB_USER=orderuser
ORDER_DB_PASSWORD=orderpass

# --- Inventory DB ---
INVENTORY_DB_ROOT_PASSWORD=rootpassword
INVENTORY_DB_USER=inventoryuser
INVENTORY_DB_PASSWORD=inventorypass

# --- Payment DB ---
PAYMENT_DB_ROOT_PASSWORD=rootpassword
PAYMENT_DB_USER=paymentuser
PAYMENT_DB_PASSWORD=paymentpass

# --- Shipping DB ---
SHIPPING_DB_ROOT_PASSWORD=rootpassword
SHIPPING_DB_USER=shippinguser
SHIPPING_DB_PASSWORD=shippingpass

# --- Auth DB ---
AUTH_DB_ROOT_PASSWORD=rootpassword
AUTH_DB_USER=authuser
AUTH_DB_PASSWORD=authpass

# --- Auth service ---
JWT_SECRET=change_me_to_a_long_random_string

# --- Internal service-to-service auth (order-worker calling payment/shipping/order) ---
# This is a long-lived JWT signed with the same JWT_SECRET above, not a password you make up.
# Generate it AFTER setting JWT_SECRET, with:
#   JWT_SECRET=<same value as above> node generate-service-token.js
# then paste the printed token as the value here.
SERVICE_TOKEN=

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
